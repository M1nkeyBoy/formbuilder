<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Syntax-checks generated C# without needing the Windows desktop libraries. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\samples\*.uibproj" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StandaloneUiBuilder.Core\StandaloneUiBuilder.Core.csproj" />
    <ProjectReference Include="..\..\src\StandaloneUiBuilder.Output.Wpf\StandaloneUiBuilder.Output.Wpf.csproj" />
    <ProjectReference Include="..\..\src\StandaloneUiBuilder.Output.WinForms\StandaloneUiBuilder.Output.WinForms.csproj" />
    <ProjectReference Include="..\..\src\StandaloneUiBuilder.Output.Blazor\StandaloneUiBuilder.Output.Blazor.csproj" />
    <ProjectReference Include="..\..\src\StandaloneUiBuilder.Output.WinUI\StandaloneUiBuilder.Output.WinUI.csproj" />
    <ProjectReference Include="..\..\src\StandaloneUiBuilder.Import.Wpf\StandaloneUiBuilder.Import.Wpf.csproj" />
    <ProjectReference Include="..\..\src\StandaloneUiBuilder.Output.Maui\StandaloneUiBuilder.Output.Maui.csproj" />
    <ProjectReference Include="..\..\src\StandaloneUiBuilder.Libraries\StandaloneUiBuilder.Libraries.csproj" />

    <!-- Built, not referenced: the scanner reads it as a library's assembly. -->
    <ProjectReference Include="..\StandaloneUiBuilder.SampleControls\StandaloneUiBuilder.SampleControls.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>

  <Target Name="CopySampleControls" AfterTargets="Build">
    <Copy SourceFiles="..\StandaloneUiBuilder.SampleControls\bin\$(Configuration)\net10.0-windows\StandaloneUiBuilder.SampleControls.dll"
          DestinationFolder="$(OutDir)SampleControls" SkipUnchangedFiles="true" />
  </Target>

</Project>
