<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Standalone UI Builder" Width="1280" Height="880"
        MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Presentation reference. Replace sample content with the existing designer surface.
         No x:Class or event handlers: this file can also be loaded by XamlReader. -->
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8F9FC"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CanvasBrush" Color="#EEF0F5"/>
        <SolidColorBrush x:Key="TextBrush" Color="#232738"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#737C90"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E4E7EF"/>
        <SolidColorBrush x:Key="SoftBrush" Color="#F0F2F7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#635BDF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEECFF"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#237854"/>
        <DrawingBrush x:Key="CanvasDotBrush" TileMode="Tile" Viewport="0,0,16,16"
                      ViewportUnits="Absolute" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource CanvasBrush}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource BorderBrush}"><GeometryDrawing.Geometry><EllipseGeometry Center="8,8" RadiusX="0.8" RadiusY="0.8"/></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style x:Key="CategoryTitle" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="4,20,0,8"/></Style>
        <Style x:Key="FocusOutline" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Margin="-3" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="8"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StudioButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SoftBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource StudioButton}"/>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ToolTile" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height" Value="64"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="4"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Native ComboBox template retained for correct popup and keyboard behavior. -->
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="14,8"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Chrome" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter RecognizesAccessKey="True"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ScreenTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="Chrome" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <!-- Project chrome -->
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Width="34" Height="34" VerticalAlignment="Center"><TextBlock Text="▦" Foreground="{DynamicResource OnAccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Grid.Column="1" Text="UI Builder" FontWeight="SemiBold" Margin="12,0,22,0" VerticalAlignment="Center"/>
                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18,0" VerticalAlignment="Center"><StackPanel><TextBlock Text="Untitled project"/><TextBlock Text="Standalone UI Builder" Style="{StaticResource MutedText}" Margin="0,3,0,0"/></StackPanel></Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SaveProjectButton" Content="_Save" Margin="0,0,8,0"/><Button x:Name="ExportProjectButton" Content="_Export project" Style="{StaticResource PrimaryButton}"/></StackPanel>
            </Grid>
        </Border>
        <!-- Main actions -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <DockPanel LastChildFill="False">
                <Border Background="{DynamicResource SoftBrush}" CornerRadius="10" Padding="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="DesignModeButton" Content="Design" GroupName="EditorMode" IsChecked="True" Style="{StaticResource ModeButton}"/><RadioButton x:Name="PreviewModeButton" Content="Preview" GroupName="EditorMode" Style="{StaticResource ModeButton}"/></StackPanel></Border>
                <Button x:Name="UndoButton" Content="↶" FontSize="20" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="RedoButton" Content="↷" FontSize="20" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" VerticalAlignment="Center"/>
                <Separator Margin="12,10"/>
                <Button x:Name="AlignLeftButton" Content="Align left" VerticalAlignment="Center"/>
                <Button x:Name="ArrangeButton" Content="Arrange ▾" VerticalAlignment="Center"/>
                <CheckBox x:Name="ShowGridCheckBox" DockPanel.Dock="Right" Content="Grid" IsChecked="True" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210" MinWidth="170"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*" MinWidth="400"/><ColumnDefinition Width="4"/><ColumnDefinition Width="270" MinWidth="240"/></Grid.ColumnDefinitions>
            <!-- Controls and layers -->
            <Border Background="{DynamicResource PanelBrush}">
                <TabControl x:Name="LibraryTabs" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ScreenTab}">
                    <TabItem Header="Controls"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12">
                        <TextBox x:Name="ControlSearchBox" Text="" AutomationProperties.Name="Find a control" ToolTip="Find a control"/>
                        <TextBlock Text="ESSENTIALS" Style="{StaticResource CategoryTitle}"/>
                        <UniformGrid Columns="2">
                            <Button Content="Label" Tag="Label" Style="{StaticResource ToolTile}"/><Button Content="Button" Tag="Button" Style="{StaticResource ToolTile}"/>
                            <Button Content="TextBox" Tag="TextBox" Style="{StaticResource ToolTile}"/><Button Content="CheckBox" Tag="CheckBox" Style="{StaticResource ToolTile}"/>
                            <Button Content="ComboBox" Tag="ComboBox" Style="{StaticResource ToolTile}"/><Button Content="Image" Tag="Image" Style="{StaticResource ToolTile}"/>
                        </UniformGrid>
                        <TextBlock Text="CONTAINERS" Style="{StaticResource CategoryTitle}"/>
                        <UniformGrid Columns="2"><Button Content="Grid" Tag="Grid" Style="{StaticResource ToolTile}"/><Button Content="StackPanel" Tag="StackPanel" Style="{StaticResource ToolTile}"/><Button Content="GroupBox" Tag="GroupBox" Style="{StaticResource ToolTile}"/><Button Content="TabControl" Tag="TabControl" Style="{StaticResource ToolTile}"/></UniformGrid>
                        <TextBlock Text="MORE CONTROLS" Style="{StaticResource CategoryTitle}"/>
                        <UniformGrid Columns="2"><Button Content="PasswordBox" Tag="PasswordBox" Style="{StaticResource ToolTile}"/><Button Content="RadioButton" Tag="RadioButton" Style="{StaticResource ToolTile}"/><Button Content="ListBox" Tag="ListBox" Style="{StaticResource ToolTile}"/><Button Content="Slider" Tag="Slider" Style="{StaticResource ToolTile}"/><Button Content="ProgressBar" Tag="ProgressBar" Style="{StaticResource ToolTile}"/><Button Content="DatePicker" Tag="DatePicker" Style="{StaticResource ToolTile}"/></UniformGrid>
                        <TextBlock Text="Drag a control onto the canvas, or select one and press Enter." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="4,20,4,12"/>
                    </StackPanel></ScrollViewer></TabItem>
                    <TabItem Header="Layers"><TreeView x:Name="LayersTree" BorderThickness="0" Background="Transparent" Margin="8"><TreeViewItem Header="Main" IsExpanded="True"><TreeViewItem Header="WelcomeLabel"/><TreeViewItem Header="NameInput"/><TreeViewItem Header="EmailInput"/><TreeViewItem Header="RoleSelect"/><TreeViewItem Header="UpdatesCheck"/><TreeViewItem Header="ContinueButton" IsSelected="True"/></TreeViewItem></TreeView></TabItem>
                </TabControl>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
            <!-- Screen navigation and design surface -->
            <Grid Grid.Column="2" Background="{DynamicResource CanvasBrush}">
                <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel><Button x:Name="AddScreenButton" DockPanel.Dock="Right" Content="+" FontSize="20" AutomationProperties.Name="Add screen" ToolTip="Add screen (Ctrl+Shift+N)" Margin="6,3"/><TabControl x:Name="ScreenTabs" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ScreenTab}"><TabItem Header="Main"/><TabItem Header="Screen2"/></TabControl></DockPanel>
                </Border>
                <Grid Grid.Row="1" Margin="18,0"><TextBlock x:Name="ScreenSizeLabel" Text="Main / 800 × 600" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><Button x:Name="FitCanvasButton" Content="Fit to canvas" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/></Grid>
                <ScrollViewer x:Name="SurfaceScroller" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource CanvasDotBrush}" Padding="24">
                    <!-- Replace SampleArtboard with the real designer Canvas/AdornerLayer.
                         Keep the existing 800x600 DIP model, zoom, hit testing, and selection. -->
                    <Border x:Name="SampleArtboard" Width="480" MinHeight="490" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Create your account" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="A little information to get you started." Style="{StaticResource MutedText}" Margin="0,5,0,26"/>
                            <Label Content="Full name" Target="{Binding ElementName=SampleNameInput}" Padding="0" Margin="0,0,0,6"/>
                            <TextBox x:Name="SampleNameInput" Text="Alex Morgan" Margin="0,0,0,18"/>
                            <Label Content="Email address" Target="{Binding ElementName=SampleEmailInput}" Padding="0" Margin="0,0,0,6"/>
                            <TextBox x:Name="SampleEmailInput" Text="alex@example.com" Margin="0,0,0,18"/>
                            <Label Content="Role" Target="{Binding ElementName=SampleRoleInput}" Padding="0" Margin="0,0,0,6"/>
                            <ComboBox x:Name="SampleRoleInput" SelectedIndex="0" Margin="0,0,0,20"><ComboBoxItem Content="Designer"/><ComboBoxItem Content="Developer"/><ComboBoxItem Content="Product manager"/></ComboBox>
                            <CheckBox Content="Send me product updates" IsChecked="True"/>
                            <Grid Margin="-7,30,-7,0">
                                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Padding="6"><Button Content="Create account →" Height="44" Style="{StaticResource PrimaryButton}"/></Border>
                                <Border Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-19,0,0" Padding="6,2" CornerRadius="4,4,0,0"><TextBlock Text="ContinueButton" FontSize="10" Foreground="{DynamicResource OnAccentBrush}"/></Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
            <!-- Contextual inspector -->
            <Border Grid.Column="4" Background="{DynamicResource PanelBrush}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18"><StackPanel><TextBlock x:Name="SelectedControlTitle" Text="ContinueButton" FontWeight="SemiBold"/><TextBlock x:Name="SelectedControlSubtitle" Text="Button · Main" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel></Border>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18"><StackPanel>
                    <TextBlock Text="Identity &amp; content" Style="{StaticResource SectionTitle}"/>
                    <Label Content="Name" Target="{Binding ElementName=ControlNameBox}" Padding="0" Style="{x:Null}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControlNameBox" Text="ContinueButton" Margin="0,0,0,14"/>
                    <Label Content="Text" Target="{Binding ElementName=ControlTextBox}" Padding="0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControlTextBox" Text="Create account"/>
                </StackPanel></Border>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18"><StackPanel>
                    <TextBlock Text="Layout" Style="{StaticResource SectionTitle}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                        <StackPanel><Label Content="X" Target="{Binding ElementName=ControlXBox}" Padding="0" Margin="0,0,0,5" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><TextBox x:Name="ControlXBox" Text="40"/></StackPanel>
                        <StackPanel Grid.Column="2"><Label Content="Y" Target="{Binding ElementName=ControlYBox}" Padding="0" Margin="0,0,0,5" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><TextBox x:Name="ControlYBox" Text="400"/></StackPanel>
                        <StackPanel Grid.Row="2"><Label Content="Width" Target="{Binding ElementName=ControlWidthBox}" Padding="0" Margin="0,0,0,5" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><TextBox x:Name="ControlWidthBox" Text="720"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2"><Label Content="Height" Target="{Binding ElementName=ControlHeightBox}" Padding="0" Margin="0,0,0,5" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><TextBox x:Name="ControlHeightBox" Text="44"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Anchor to" Style="{StaticResource FieldLabel}" Margin="0,16,0,8"/><WrapPanel><CheckBox x:Name="AnchorLeft" Content="Left" IsChecked="True"/><CheckBox x:Name="AnchorTop" Content="Top" IsChecked="True"/><CheckBox x:Name="AnchorRight" Content="Right" IsChecked="True"/><CheckBox x:Name="AnchorBottom" Content="Bottom"/></WrapPanel>
                </StackPanel></Border>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18"><StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Background" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Border Background="{DynamicResource AccentBrush}" Width="20" Height="20" CornerRadius="5" Margin="0,0,8,0"/><TextBlock Text="Accent" VerticalAlignment="Center"/></StackPanel>
                    <Label Content="Font" Target="{Binding ElementName=FontFamilyPicker}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Padding="0" Margin="0,0,0,5"/><ComboBox x:Name="FontFamilyPicker" SelectedIndex="0"><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Arial"/></ComboBox>
                </StackPanel></Border>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18"><StackPanel><TextBlock Text="Interaction" Style="{StaticResource SectionTitle}"/><Label Content="On click" Target="{Binding ElementName=ClickActionPicker}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Padding="0" Margin="0,0,0,5"/><ComboBox x:Name="ClickActionPicker" SelectedIndex="0"><ComboBoxItem Content="Nothing else"/><ComboBoxItem Content="Open Screen2"/><ComboBoxItem Content="Close window"/></ComboBox></StackPanel></Border>
                <!-- Existing screen properties stay available when no control is selected. -->
                <Expander Header="Screen settings" Margin="18"><StackPanel Margin="0,12,0,0"><TextBlock Text="Screen name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ScreenNameBox" Text="Main" AutomationProperties.Name="Screen name" Margin="0,0,0,12"/><TextBlock Text="Width × height (DIPs)" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="ScreenWidthBox" Text="800" AutomationProperties.Name="Screen width"/><TextBox Grid.Column="2" x:Name="ScreenHeightBox" Text="600" AutomationProperties.Name="Screen height"/></Grid></StackPanel></Expander>
            </StackPanel></ScrollViewer></Border>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0"><DockPanel LastChildFill="False"><TextBlock x:Name="StatusText" Text="✓ Ready" Foreground="{DynamicResource SuccessBrush}" FontSize="11" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="WPF · 800 × 600 DIPs" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="6 controls" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,18,0" VerticalAlignment="Center"/></DockPanel></Border>
    </Grid>
</Window>
