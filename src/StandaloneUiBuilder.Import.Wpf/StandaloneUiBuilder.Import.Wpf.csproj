<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads WPF window XAML into a builder project. Plain XML reading: it does not depend on
       WPF, so it builds and is tested on any platform. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StandaloneUiBuilder.Core\StandaloneUiBuilder.Core.csproj" />
  </ItemGroup>

</Project>
