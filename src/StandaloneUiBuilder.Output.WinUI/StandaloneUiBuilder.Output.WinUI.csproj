<Project Sdk="Microsoft.NET.Sdk">

  <!-- Turns a builder project into a WinUI 3 app. Plain text generation: it does not depend
       on the Windows App SDK, so it builds and is tested on any platform. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StandaloneUiBuilder.Core\StandaloneUiBuilder.Core.csproj" />
    <ProjectReference Include="..\StandaloneUiBuilder.Output\StandaloneUiBuilder.Output.csproj" />
  </ItemGroup>

</Project>
