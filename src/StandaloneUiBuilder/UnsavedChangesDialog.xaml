<Window x:Class="StandaloneUiBuilder.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved changes"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20,16" MaxWidth="420">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Save" MinWidth="80" Padding="10,3" IsDefault="True" Click="Save_Click" />
            <Button Content="_Discard" MinWidth="80" Padding="10,3" Margin="8,0,0,0" Click="Discard_Click" />
            <Button Content="Cancel" MinWidth="80" Padding="10,3" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
