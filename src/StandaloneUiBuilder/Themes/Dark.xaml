<!-- The editor's colours in the dark theme, following the light theme's roles. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1D1E24" />
    <SolidColorBrush x:Key="PanelBrush" Color="#25262D" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#16171C" />
    <SolidColorBrush x:Key="TextBrush" Color="#E7E9F0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3B5" />
    <SolidColorBrush x:Key="BorderBrush" Color="#373944" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#4B4E5B" />
    <SolidColorBrush x:Key="SoftBrush" Color="#30323B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8C86F2" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#34315C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#5CC28F" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A7A" />
    <SolidColorBrush x:Key="ArtboardBorderBrush" Color="#4B4E5B" />
</ResourceDictionary>
