<Window x:Class="StandaloneUiBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:StandaloneUiBuilder.Design"
        xmlns:local="clr-namespace:StandaloneUiBuilder"
        Title="Standalone UI Builder"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,8,10,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Width" Value="72" />
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style x:Key="FieldRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="10,0,10,6" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="10,0,10,0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.SaveAs" Key="S" Modifiers="Ctrl+Shift" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" />
        <CommandBinding Command="{x:Static local:EditorCommands.ImportWpf}" Executed="ImportWpf_Executed" />
        <CommandBinding Command="{x:Static local:EditorCommands.ExportWpf}" Executed="ExportWpf_Executed" />
        <CommandBinding Command="{x:Static local:EditorCommands.ExportWinForms}" Executed="ExportWinForms_Executed" />
        <CommandBinding Command="{x:Static local:EditorCommands.ExportWinUI}" Executed="ExportWinUI_Executed" />
        <CommandBinding Command="{x:Static local:EditorCommands.ExportMaui}" Executed="ExportMaui_Executed" />
        <CommandBinding Command="{x:Static local:EditorCommands.ExportBlazor}" Executed="ExportBlazor_Executed" />
        <CommandBinding Command="ApplicationCommands.Delete" Executed="Delete_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Cut" Executed="Cut_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste_Executed" CanExecute="Paste_CanExecute" />
        <CommandBinding Command="ApplicationCommands.SelectAll" Executed="SelectAll_Executed" CanExecute="SelectAll_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.Duplicate}" Executed="Duplicate_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.BringToFront}" Executed="BringToFront_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.SendToBack}" Executed="SendToBack_Executed" CanExecute="HasSelection_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.Arrange}" Executed="Arrange_Executed" CanExecute="Arrange_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.SetTabOrder}" Executed="SetTabOrder_Executed" CanExecute="Designing_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.TabOrderByPosition}" Executed="TabOrderByPosition_Executed" CanExecute="Designing_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.ResetTabOrder}" Executed="ResetTabOrder_Executed" CanExecute="ResetTabOrder_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.SetTheme}" Executed="SetTheme_Executed" CanExecute="Designing_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.AddScreen}" Executed="AddScreen_Executed" CanExecute="Designing_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.DuplicateScreen}" Executed="DuplicateScreen_Executed" CanExecute="Designing_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.DeleteScreen}" Executed="DeleteScreen_Executed" CanExecute="DeleteScreen_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.MoveScreenEarlier}" Executed="MoveScreenEarlier_Executed" CanExecute="MoveScreenEarlier_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.MoveScreenLater}" Executed="MoveScreenLater_Executed" CanExecute="MoveScreenLater_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.PreviousScreen}" Executed="PreviousScreen_Executed" CanExecute="PreviousScreen_CanExecute" />
        <CommandBinding Command="{x:Static local:EditorCommands.NextScreen}" Executed="NextScreen_Executed" CanExecute="NextScreen_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" CanExecute="Undo_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Executed" CanExecute="Redo_CanExecute" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="ApplicationCommands.New" />
                <MenuItem Header="_Open…" Command="ApplicationCommands.Open" />
                <MenuItem Header="_Save" Command="ApplicationCommands.Save" />
                <MenuItem Header="Save _As…" Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Command="{x:Static local:EditorCommands.ImportWpf}" />
                <Separator />
                <MenuItem Command="{x:Static local:EditorCommands.ExportWpf}" />
                <MenuItem Command="{x:Static local:EditorCommands.ExportWinForms}" InputGestureText="Ctrl+Shift+E" />
                <MenuItem Command="{x:Static local:EditorCommands.ExportWinUI}" />
                <MenuItem Command="{x:Static local:EditorCommands.ExportMaui}" />
                <MenuItem Command="{x:Static local:EditorCommands.ExportBlazor}" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" />
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" />
                <Separator />
                <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" />
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" />
                <MenuItem Command="{x:Static local:EditorCommands.Duplicate}" />
                <MenuItem Header="_Delete" Command="ApplicationCommands.Delete" />
                <Separator />
                <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll" />
                <Separator />
                <MenuItem Command="{x:Static local:EditorCommands.BringToFront}" InputGestureText="Ctrl+]" />
                <MenuItem Command="{x:Static local:EditorCommands.SendToBack}" InputGestureText="Ctrl+[" />
            </MenuItem>
            <MenuItem Header="F_ormat">
                <MenuItem Header="Align _Lefts" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Lefts" />
                <MenuItem Header="Align _Centres" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Centers" />
                <MenuItem Header="Align _Rights" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Rights" />
                <Separator />
                <MenuItem Header="Align _Tops" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Tops" />
                <MenuItem Header="Align _Middles" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Middles" />
                <MenuItem Header="Align _Bottoms" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Bottoms" />
                <Separator />
                <MenuItem Header="Make Same _Width" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Width" />
                <MenuItem Header="Make Same _Height" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Height" />
                <MenuItem Header="Make Same _Size" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Both" />
                <Separator />
                <MenuItem Header="Distribute _Across" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Horizontally" />
                <MenuItem Header="Distribute _Down" Command="{x:Static local:EditorCommands.Arrange}" CommandParameter="Vertically" />
                <Separator />
                <MenuItem Header="The last control selected is the one the others follow." IsEnabled="False" />
                <Separator />
                <MenuItem x:Name="SetTabOrderMenuItem" Command="{x:Static local:EditorCommands.SetTabOrder}" IsCheckable="False" />
                <MenuItem Command="{x:Static local:EditorCommands.TabOrderByPosition}" />
                <MenuItem Command="{x:Static local:EditorCommands.ResetTabOrder}" />
            </MenuItem>
            <MenuItem Header="_Screen">
                <MenuItem Command="{x:Static local:EditorCommands.AddScreen}" InputGestureText="Ctrl+Shift+N" />
                <MenuItem Command="{x:Static local:EditorCommands.DuplicateScreen}" />
                <MenuItem Command="{x:Static local:EditorCommands.DeleteScreen}" />
                <Separator />
                <MenuItem Command="{x:Static local:EditorCommands.MoveScreenEarlier}" />
                <MenuItem Command="{x:Static local:EditorCommands.MoveScreenLater}" />
                <Separator />
                <MenuItem Command="{x:Static local:EditorCommands.PreviousScreen}" InputGestureText="Ctrl+PgUp" />
                <MenuItem Command="{x:Static local:EditorCommands.NextScreen}" InputGestureText="Ctrl+PgDn" />
            </MenuItem>
            <MenuItem Header="_Project">
                <MenuItem Header="_Theme">
                    <MenuItem x:Name="LightThemeMenuItem" Header="_Light" Command="{x:Static local:EditorCommands.SetTheme}" CommandParameter="Light" />
                    <MenuItem x:Name="DarkThemeMenuItem" Header="_Dark" Command="{x:Static local:EditorCommands.SetTheme}" CommandParameter="Dark" />
                    <MenuItem x:Name="SystemThemeMenuItem" Header="Follow _Windows or Browser" Command="{x:Static local:EditorCommands.SetTheme}" CommandParameter="System" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="DesignMenuItem" Header="_Design" IsCheckable="True" IsChecked="True" Click="DesignMenuItem_Click" />
                <MenuItem x:Name="PreviewMenuItem" Header="_Preview" IsCheckable="True" Click="PreviewMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <DockPanel Margin="8,4">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton x:Name="DesignModeButton" Content="Design" GroupName="Mode"
                                 IsChecked="True" Padding="10,2" MinWidth="72"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Checked="DesignModeButton_Checked" />
                    <RadioButton x:Name="PreviewModeButton" Content="Preview" GroupName="Mode"
                                 Padding="10,2" MinWidth="72" Margin="4,0,0,0"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Checked="PreviewModeButton_Checked" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="12,0,4,0" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <TextBlock DockPanel.Dock="Top" Text="Toolbox" Style="{StaticResource PanelHeader}" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource PlaceholderText}" Margin="10,8,10,10"
                           Text="Drag a control onto the canvas. Or select one, then click the canvas or press Enter." />
                <ListBox x:Name="ToolboxList" Margin="6,0" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Toolbox"
                         PreviewMouseLeftButtonDown="ToolboxList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ToolboxList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="ToolboxList_PreviewMouseLeftButtonUp"
                         KeyDown="ToolboxList_KeyDown"
                         SelectionChanged="ToolboxList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Type}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Type}" Padding="6,4" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Focusable="False" />

            <DockPanel Grid.Column="2">
                <!-- One tab per screen; the first is the one a generated app opens with. -->
                <DockPanel DockPanel.Dock="Top" Margin="6,4,6,0">
                    <Button x:Name="AddScreenButton" DockPanel.Dock="Right" Content="+" Padding="8,0" Margin="4,2,0,2"
                            Command="{x:Static local:EditorCommands.AddScreen}"
                            AutomationProperties.Name="Add screen" ToolTip="Add a screen (Ctrl+Shift+N)" />
                    <ListBox x:Name="ScreenTabs" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Screens"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="ScreenTabs_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Margin" Value="0,0,2,0" />
                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="8,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <ScrollViewer x:Name="SurfaceScroller"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}">
                    <Border Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                            BorderBrush="#FFB8BFC8" BorderThickness="1">
                        <design:DesignSurface x:Name="Surface" />
                    </Border>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Focusable="False" />

            <DockPanel Grid.Column="4" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <TextBlock DockPanel.Dock="Top" Text="Properties" Style="{StaticResource PanelHeader}" />
                <TextBlock x:Name="NoSelectionText" DockPanel.Dock="Top" Style="{StaticResource PlaceholderText}"
                           Text="Select a control to edit its properties." />
                <StackPanel x:Name="ScreenPanel" DockPanel.Dock="Top" Margin="0,10,0,0">
                    <TextBlock Text="Screen" Style="{StaticResource PanelHeader}" />
                    <DockPanel Style="{StaticResource FieldRow}">
                        <Label Content="Na_me" Target="{Binding ElementName=ScreenNameBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ScreenNameBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Screen name" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource FieldRow}">
                        <Label Content="Wi_dth" Target="{Binding ElementName=ScreenWidthBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ScreenWidthBox" Style="{StaticResource FieldBox}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource FieldRow}">
                        <Label Content="H_eight" Target="{Binding ElementName=ScreenHeightBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ScreenHeightBox" Style="{StaticResource FieldBox}" />
                    </DockPanel>
                    <TextBlock x:Name="ScreenErrorText" Margin="10,0,10,6" TextWrapping="Wrap"
                               Foreground="#FFC42B1C" Visibility="Collapsed" />
                    <TextBlock Style="{StaticResource PlaceholderText}" Margin="10,0,10,6"
                               Text="The design size in DIPs. Every control must still fit. The name becomes the screen's window in exported code; the first screen is the main window." />
                </StackPanel>
                <ScrollViewer x:Name="InspectorPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Style="{StaticResource FieldRow}">
                            <Label Content="Type" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="TypeText" VerticalAlignment="Center" Padding="3,4" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FieldRow}">
                            <Label Content="_Name" Target="{Binding ElementName=NameBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel x:Name="XRow" Style="{StaticResource FieldRow}">
                            <Label Content="_X" Target="{Binding ElementName=XBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="XBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel x:Name="YRow" Style="{StaticResource FieldRow}">
                            <Label Content="_Y" Target="{Binding ElementName=YBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="YBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel x:Name="WidthRow" Style="{StaticResource FieldRow}">
                            <Label Content="_Width" Target="{Binding ElementName=WidthBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="WidthBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel x:Name="HeightRow" Style="{StaticResource FieldRow}">
                            <Label Content="_Height" Target="{Binding ElementName=HeightBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HeightBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel x:Name="AnchorRow" Style="{StaticResource FieldRow}">
                            <Label Content="Anchor" Style="{StaticResource FieldLabel}" VerticalContentAlignment="Top" />
                            <UniformGrid Columns="2" ToolTip="Edges the control follows when the window is resized. Left and Right together, or Top and Bottom together, make it stretch.">
                                <CheckBox x:Name="AnchorLeftBox" Content="Left" Margin="0,2" Click="AnchorBox_Click" />
                                <CheckBox x:Name="AnchorTopBox" Content="Top" Margin="0,2" Click="AnchorBox_Click" />
                                <CheckBox x:Name="AnchorRightBox" Content="Right" Margin="0,2" Click="AnchorBox_Click" />
                                <CheckBox x:Name="AnchorBottomBox" Content="Bottom" Margin="0,2" Click="AnchorBox_Click" />
                            </UniformGrid>
                        </DockPanel>
                        <DockPanel x:Name="CellRow" Style="{StaticResource FieldRow}"
                                   ToolTip="The Grid cell this control fills, counted from 0.">
                            <Label Content="Cell" Style="{StaticResource FieldLabel}" />
                            <UniformGrid Columns="4">
                                <Label Content="_Row" Target="{Binding ElementName=RowBox}" Padding="0,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="RowBox" Style="{StaticResource FieldBox}" />
                                <Label Content="C_ol" Target="{Binding ElementName=ColumnBox}" Padding="6,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="ColumnBox" Style="{StaticResource FieldBox}" />
                            </UniformGrid>
                        </DockPanel>
                        <DockPanel x:Name="SpanRow" Style="{StaticResource FieldRow}"
                                   ToolTip="How many rows and columns of the Grid this control covers.">
                            <Label Content="Span" Style="{StaticResource FieldLabel}" />
                            <UniformGrid Columns="4">
                                <Label Content="Rows" Target="{Binding ElementName=RowSpanBox}" Padding="0,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="RowSpanBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Row span" />
                                <Label Content="Cols" Target="{Binding ElementName=ColumnSpanBox}" Padding="6,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="ColumnSpanBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Column span" />
                            </UniformGrid>
                        </DockPanel>
                        <DockPanel x:Name="OrderRow" Style="{StaticResource FieldRow}"
                                   ToolTip="The control's place among the others in its StackPanel.">
                            <Label Content="Order" Style="{StaticResource FieldLabel}" />
                            <UniformGrid Columns="2">
                                <Button x:Name="EarlierButton" Content="Earlier" Margin="0,0,3,0" Click="EarlierButton_Click" />
                                <Button x:Name="LaterButton" Content="Later" Margin="3,0,0,0" Click="LaterButton_Click" />
                            </UniformGrid>
                        </DockPanel>
                        <DockPanel x:Name="OrientationRow" Style="{StaticResource FieldRow}">
                            <Label Content="Direction" Target="{Binding ElementName=OrientationBox}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="OrientationBox" SelectionChanged="OrientationBox_SelectionChanged"
                                      AutomationProperties.Name="Direction">
                                <ComboBoxItem Content="Vertical" />
                                <ComboBoxItem Content="Horizontal" />
                            </ComboBox>
                        </DockPanel>
                        <DockPanel x:Name="SpacingRow" Style="{StaticResource FieldRow}">
                            <Label Content="_Spacing" Target="{Binding ElementName=SpacingBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SpacingBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel x:Name="GridSizeRow" Style="{StaticResource FieldRow}">
                            <Label Content="Cells" Style="{StaticResource FieldLabel}" />
                            <UniformGrid Columns="4">
                                <Label Content="Ro_ws" Target="{Binding ElementName=RowsBox}" Padding="0,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="RowsBox" Style="{StaticResource FieldBox}" />
                                <Label Content="Co_ls" Target="{Binding ElementName=ColumnsBox}" Padding="6,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="ColumnsBox" Style="{StaticResource FieldBox}" />
                            </UniformGrid>
                        </DockPanel>
                        <StackPanel x:Name="TrackSizesRow" Margin="10,0,10,6"
                                    ToolTip="One size per row or column, separated by commas: a number of DIPs (100), or a share of the space left (* or 2*).">
                            <Label Content="Row si_zes" Target="{Binding ElementName=RowSizesBox}" Padding="0,0,0,3" />
                            <TextBox x:Name="RowSizesBox" Style="{StaticResource FieldBox}" Margin="0,0,0,6" />
                            <Label Content="Col_umn sizes" Target="{Binding ElementName=ColumnSizesBox}" Padding="0,0,0,3" />
                            <TextBox x:Name="ColumnSizesBox" Style="{StaticResource FieldBox}" />
                        </StackPanel>
                        <DockPanel x:Name="TextRow" Style="{StaticResource FieldRow}">
                            <Label Content="_Text" Target="{Binding ElementName=TextValueBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TextValueBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel x:Name="ActionRow" Style="{StaticResource FieldRow}"
                                   ToolTip="What clicking the button does in Preview and in exported code, after its hook.">
                            <Label Content="On click" Target="{Binding ElementName=ActionBox}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ActionBox" AutomationProperties.Name="On click"
                                      DisplayMemberPath="Label" SelectionChanged="ActionBox_SelectionChanged" />
                        </DockPanel>
                        <DockPanel x:Name="TabsRow" Style="{StaticResource FieldRow}"
                                   ToolTip="The tab shown on the canvas and when the screen opens. Click a tab on the canvas to show it too.">
                            <Label Content="Shown tab" Target="{Binding ElementName=ShownTabBox}" Style="{StaticResource FieldLabel}" />
                            <Button x:Name="AddTabButton" DockPanel.Dock="Right" Content="Add tab" Margin="6,0,0,0" Padding="6,0"
                                    Click="AddTabButton_Click" />
                            <ComboBox x:Name="ShownTabBox" AutomationProperties.Name="Shown tab"
                                      SelectionChanged="ShownTabBox_SelectionChanged" />
                        </DockPanel>
                        <DockPanel x:Name="MultilineRow" Style="{StaticResource FieldRow}"
                                   ToolTip="Several lines of text that wrap, with a scroll bar when needed.">
                            <Label Content="Lines" Style="{StaticResource FieldLabel}" />
                            <CheckBox x:Name="MultilineBox" Content="Multi-line" VerticalAlignment="Center"
                                      Click="MultilineBox_Click" />
                        </DockPanel>
                        <DockPanel x:Name="RangeRow" Style="{StaticResource FieldRow}"
                                   ToolTip="Whole numbers: the lowest and highest values, and the value shown.">
                            <Label Content="Range" Style="{StaticResource FieldLabel}" VerticalContentAlignment="Top" />
                            <UniformGrid Columns="2">
                                <Label Content="M_inimum" Target="{Binding ElementName=MinimumBox}" Padding="0,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="MinimumBox" Style="{StaticResource FieldBox}" Margin="0,0,0,4" />
                                <Label Content="Maxim_um" Target="{Binding ElementName=MaximumBox}" Padding="0,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="MaximumBox" Style="{StaticResource FieldBox}" Margin="0,0,0,4" />
                                <Label Content="_Value" Target="{Binding ElementName=ValueBox}" Padding="0,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="ValueBox" Style="{StaticResource FieldBox}" />
                            </UniformGrid>
                        </DockPanel>
                        <DockPanel x:Name="IsCheckedRow" Style="{StaticResource FieldRow}">
                            <Label Content="Checked" Style="{StaticResource FieldLabel}" />
                            <CheckBox x:Name="IsCheckedBox" VerticalAlignment="Center"
                                      AutomationProperties.Name="Checked" Click="IsCheckedBox_Click" />
                        </DockPanel>
                        <StackPanel x:Name="ItemsRow" Margin="10,0,10,6">
                            <Label Content="_Items (one per line)" Target="{Binding ElementName=ItemsBox}" Padding="0,0,0,3" />
                            <TextBox x:Name="ItemsBox" Style="{StaticResource FieldBox}" AcceptsReturn="True"
                                     MinLines="4" MaxLines="12" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" />
                        </StackPanel>
                        <DockPanel x:Name="ImageRow" Style="{StaticResource FieldRow}">
                            <Label Content="Picture" Style="{StaticResource FieldLabel}" VerticalContentAlignment="Top" />
                            <StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,4">
                                    <Button x:Name="ChooseImageButton" Content="Choose…" Margin="0,0,3,0" Click="ChooseImageButton_Click"
                                            ToolTip="A PNG, JPEG, GIF or BMP file of up to 2 MB, stored in the project." />
                                    <Button x:Name="RemoveImageButton" Content="Remove" Margin="3,0,0,0" Click="RemoveImageButton_Click" />
                                </UniformGrid>
                                <ComboBox x:Name="StretchBox" AutomationProperties.Name="Picture fit" SelectionChanged="StretchBox_SelectionChanged">
                                    <ComboBoxItem Content="Fit, keeping its shape" />
                                    <ComboBoxItem Content="Stretch to fill" />
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel x:Name="FontRow" Style="{StaticResource FieldRow}"
                                   ToolTip="Text size in DIPs; leave blank for the standard size (12).">
                            <Label Content="Font" Target="{Binding ElementName=FontSizeBox}" Style="{StaticResource FieldLabel}" />
                            <CheckBox x:Name="BoldBox" DockPanel.Dock="Right" Content="Bold" VerticalAlignment="Center"
                                      Margin="8,0,0,0" Click="BoldBox_Click" />
                            <TextBox x:Name="FontSizeBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Text size" />
                        </DockPanel>
                        <DockPanel x:Name="ColorRow" Style="{StaticResource FieldRow}"
                                   ToolTip="Colours as #RRGGBB, for example #1E6FD9; leave blank for the standard colours.">
                            <Label Content="Colours" Style="{StaticResource FieldLabel}" VerticalContentAlignment="Top" />
                            <UniformGrid Columns="2">
                                <Label x:Name="TextColorLabel" Content="Text" Target="{Binding ElementName=TextColorBox}" Padding="0,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="TextColorBox" Style="{StaticResource FieldBox}" Margin="0,0,0,4" AutomationProperties.Name="Text colour" />
                                <Label Content="Back" Target="{Binding ElementName=BackgroundBox}" Padding="0,0,4,0" VerticalContentAlignment="Center" />
                                <TextBox x:Name="BackgroundBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Background colour" />
                            </UniformGrid>
                        </DockPanel>
                        <TextBlock x:Name="InspectorErrorText" Margin="10,4,10,6" TextWrapping="Wrap"
                                   Foreground="#FFC42B1C" Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource PlaceholderText}" Margin="10,4,10,10"
                                   Text="Press Enter or leave a field to apply. Esc restores the current value." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
