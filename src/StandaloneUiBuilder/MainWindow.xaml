<Window x:Class="StandaloneUiBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:StandaloneUiBuilder.Design"
        Title="Standalone UI Builder"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,8,10,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Width" Value="72" />
            <Setter Property="Padding" Value="0,0,6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style x:Key="FieldRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="10,0,10,6" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="10,0,10,0" />
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed" />
        <CommandBinding Command="ApplicationCommands.Delete" Executed="Delete_Executed" CanExecute="Delete_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" CanExecute="Undo_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Executed" CanExecute="Redo_CanExecute" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="ApplicationCommands.New" />
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" IsEnabled="False" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" IsEnabled="False" />
                <MenuItem Header="Save _As…" IsEnabled="False" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" />
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" />
                <Separator />
                <MenuItem Header="_Delete" Command="ApplicationCommands.Delete" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="DesignMenuItem" Header="_Design" IsCheckable="True" IsChecked="True" Click="DesignMenuItem_Click" />
                <MenuItem x:Name="PreviewMenuItem" Header="_Preview" IsCheckable="True" Click="PreviewMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <DockPanel Margin="8,4">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton x:Name="DesignModeButton" Content="Design" GroupName="Mode"
                                 IsChecked="True" Padding="10,2" MinWidth="72"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Checked="DesignModeButton_Checked" />
                    <RadioButton x:Name="PreviewModeButton" Content="Preview" GroupName="Mode"
                                 Padding="10,2" MinWidth="72" Margin="4,0,0,0"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Checked="PreviewModeButton_Checked" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="12,0,4,0" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <TextBlock DockPanel.Dock="Top" Text="Toolbox" Style="{StaticResource PanelHeader}" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource PlaceholderText}" Margin="10,8,10,10"
                           Text="Drag a control onto the canvas. Or select one, then click the canvas or press Enter." />
                <ListBox x:Name="ToolboxList" Margin="6,0" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Toolbox"
                         PreviewMouseLeftButtonDown="ToolboxList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ToolboxList_PreviewMouseMove"
                         KeyDown="ToolboxList_KeyDown"
                         SelectionChanged="ToolboxList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Type}" Padding="6,4" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Focusable="False" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Design surface" Style="{StaticResource PanelHeader}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}">
                    <Border Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                            BorderBrush="#FFB8BFC8" BorderThickness="1">
                        <design:DesignSurface x:Name="Surface" />
                    </Border>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Focusable="False" />

            <DockPanel Grid.Column="4" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <TextBlock DockPanel.Dock="Top" Text="Properties" Style="{StaticResource PanelHeader}" />
                <TextBlock x:Name="NoSelectionText" DockPanel.Dock="Top" Style="{StaticResource PlaceholderText}"
                           Text="Select a control to edit its properties." />
                <ScrollViewer x:Name="InspectorPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Style="{StaticResource FieldRow}">
                            <Label Content="Type" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="TypeText" VerticalAlignment="Center" Padding="3,4" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FieldRow}">
                            <Label Content="_Name" Target="{Binding ElementName=NameBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FieldRow}">
                            <Label Content="_X" Target="{Binding ElementName=XBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="XBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FieldRow}">
                            <Label Content="_Y" Target="{Binding ElementName=YBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="YBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FieldRow}">
                            <Label Content="_Width" Target="{Binding ElementName=WidthBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="WidthBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource FieldRow}">
                            <Label Content="_Height" Target="{Binding ElementName=HeightBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HeightBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel x:Name="TextRow" Style="{StaticResource FieldRow}">
                            <Label Content="_Text" Target="{Binding ElementName=TextValueBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TextValueBox" Style="{StaticResource FieldBox}" />
                        </DockPanel>
                        <DockPanel x:Name="IsCheckedRow" Style="{StaticResource FieldRow}">
                            <Label Content="Checked" Style="{StaticResource FieldLabel}" />
                            <CheckBox x:Name="IsCheckedBox" VerticalAlignment="Center"
                                      AutomationProperties.Name="Checked" Click="IsCheckedBox_Click" />
                        </DockPanel>
                        <StackPanel x:Name="ItemsRow" Margin="10,0,10,6">
                            <Label Content="_Items (one per line)" Target="{Binding ElementName=ItemsBox}" Padding="0,0,0,3" />
                            <TextBox x:Name="ItemsBox" Style="{StaticResource FieldBox}" AcceptsReturn="True"
                                     MinLines="4" MaxLines="12" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" />
                        </StackPanel>
                        <TextBlock x:Name="InspectorErrorText" Margin="10,4,10,6" TextWrapping="Wrap"
                                   Foreground="#FFC42B1C" Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource PlaceholderText}" Margin="10,4,10,10"
                                   Text="Press Enter or leave a field to apply. Esc restores the current value." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
