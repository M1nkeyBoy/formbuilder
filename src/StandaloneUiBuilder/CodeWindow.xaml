<Window x:Class="StandaloneUiBuilder.CodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code"
        Width="900" Height="600" MinWidth="600" MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary Source="Themes/Studio.xaml" />
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" MinWidth="88" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            <Button Content="Cancel" MinWidth="88" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Right" Width="260" Margin="12,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Hooks you can write" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource MutedText}"
                       Text="Double-click one, or choose it and press Add, to start it at the end of your code." />
            <Button x:Name="AddHookButton" DockPanel.Dock="Bottom" Content="_Add" HorizontalAlignment="Left" MinWidth="80" Style="{StaticResource OutlineButton}" Margin="0,6,0,0" Click="AddHook_Click" />
            <TextBlock x:Name="MembersText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource MutedText}" />
            <ListBox x:Name="HooksList" MouseDoubleClick="HooksList_MouseDoubleClick"
                     AutomationProperties.Name="Hooks you can write">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Title}" FontFamily="Consolas" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Style="{StaticResource MutedText}" />
        <TextBox x:Name="CodeBox" FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Stretch" Background="{DynamicResource PanelBrush}"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Code"
                 PreviewKeyDown="CodeBox_PreviewKeyDown" />
    </DockPanel>
</Window>
