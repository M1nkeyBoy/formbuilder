<Window x:Class="StandaloneUiBuilder.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project"
        Width="640" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Studio.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A platform as a card: its name and what it is for. -->
            <Style x:Key="PlatformCard" TargetType="ListBoxItem" BasedOn="{StaticResource ListItem}">
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Chrome" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SoftBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Choose a platform" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12"
                   Text="The platform decides what Export writes and which control libraries you can add, such as Syncfusion or Telerik. Project > Platform changes it later." />
        <ListBox x:Name="PlatformList" AutomationProperties.Name="Platform" ItemContainerStyle="{StaticResource PlatformCard}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="PlatformList_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CreateButton" Content="Create" MinWidth="88" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Create_Click" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
